PORT=8000
HOST=0.0.0.0
ENV=development

# LLM provider: "mock" (no key required) or "gemini"
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Processing limits
MAX_AUDIO_DURATION_SEC=60
MAX_IMAGE_SIZE_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ENABLE_BG_REMOVAL=false
